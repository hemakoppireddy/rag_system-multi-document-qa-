{
  "name": "rag-multi-document-qa",
  "version": "1.0.0",
  "description": "Multi-Document Question Answering RAG System with Vector and Relational Databases",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev --prefix client\"",
    "client:install": "npm install --prefix client",
    "client:build": "npm run build --prefix client",
    "build": "npm run client:install && npm run client:build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "setup": "npm install && npm run client:install && npm run client:build"
  },
  "keywords": [
    "rag",
    "vector-database",
    "question-answering",
    "llm",
    "embeddings",
    "multi-document",
    "sqlite",
    "express",
    "react"
  ],
  "author": "Hema Koppireddy",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.85.4",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.12.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "docx": "^9.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 30000
  }
}
