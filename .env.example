# =================================================================
# Server Configuration
# =================================================================
PORT=3000
NODE_ENV=development

# =================================================================
# AI & Embedding Provider Configuration
# Supported AI_PROVIDER values: 'openai', 'gemini', 'local'
# Default: 'openai'
# =================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Models
# OpenAI defaults: gpt-4o-mini, text-embedding-3-small
# Gemini defaults: gemini-2.5-flash, text-embedding-004
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# =================================================================
# Vector Database Configuration
# Supported VECTOR_DB_TYPE values: 'local' (built-in persistent store), 'qdrant', 'chroma', 'pinecone'
# =================================================================
VECTOR_DB_TYPE=local
VECTOR_STORE_PATH=./data/vector_store.json
VECTOR_COLLECTION_NAME=rag_documents
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=

# Retrieval Parameters
SIMILARITY_THRESHOLD=0.65
TOP_K=5

# =================================================================
# Chunking Strategy Configuration
# =================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# =================================================================
# Relational Database Configuration
# =================================================================
DATABASE_PATH=./data/rag_history.db

# =================================================================
# Document Upload Configuration
# =================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
